# Variables del stack de produccion (docker-compose.prod.yml).
#
# Copiar a .env.prod y reemplazar TODOS los valores. En Coolify no se sube el
# archivo: cada variable se carga en la seccion Environment Variables del
# recurso, que las guarda cifradas.
#
# Ningun valor de este archivo sirve como esta: son marcadores.

# ── Base de datos ──────────────────────────────────────────────────────────
# La usan Postgres, el backend y Supabase Storage. Generar con:
#   openssl rand -hex 24
POSTGRES_PASSWORD=reemplazar-con-openssl-rand-hex-24

# ── JWT de la aplicacion ───────────────────────────────────────────────────
# El de PatiPets, para sus sesiones. No tiene relacion con el de Storage y
# tiene que ser distinto. Generar con:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=reemplazar-con-openssl-rand-base64-64

# ── Supabase Storage ───────────────────────────────────────────────────────
# Las tres van juntas: las dos claves son tokens JWT firmados con el secreto, y
# storage-api rechaza cualquier peticion cuya firma no cuadre. Generar el trio
# de una vez (no inventar los tokens a mano, tienen que estar firmados):
#
#   python3 - <<'EOF'
#   import hmac, hashlib, base64, json, time, secrets
#   b64 = lambda d: base64.urlsafe_b64encode(d).decode().rstrip('=')
#   def jwt(payload, secret):
#       head = b64(json.dumps({"alg":"HS256","typ":"JWT"},separators=(',',':')).encode())
#       body = b64(json.dumps(payload,separators=(',',':')).encode())
#       sig  = hmac.new(secret.encode(), f"{head}.{body}".encode(), hashlib.sha256).digest()
#       return f"{head}.{body}.{b64(sig)}"
#   s   = secrets.token_hex(32)
#   iat = int(time.time()); exp = iat + 60*60*24*365*10
#   print("SUPABASE_JWT_SECRET=" + s)
#   for role in ("anon", "service_role"):
#       print(f"SUPABASE_{'ANON' if role=='anon' else 'SERVICE'}_KEY=" +
#             jwt({"role":role,"iss":"supabase","iat":iat,"exp":exp}, s))
#   EOF
#
SUPABASE_JWT_SECRET=reemplazar-con-el-script-de-arriba
SUPABASE_ANON_KEY=reemplazar-con-el-script-de-arriba
SUPABASE_SERVICE_KEY=reemplazar-con-el-script-de-arriba

# Dominio publico del gateway de Storage, con HTTPS. Es la raiz de las URL que
# el backend guarda en la base y que el navegador carga para mostrar las fotos,
# asi que tiene que resolver desde internet. En Coolify se asigna al servicio
# `gateway`.
SUPABASE_PUBLIC_URL=https://storage.patipets.ejemplo.dev
